# Rahil Gallery — environment variables

# Backend APIs (Strangler Fig: Go + Django behind same-origin /api/v1)
# Same-origin proxy (recommended for local dev):
NEXT_PUBLIC_API_BASE_URL=/api/v1
GO_API_PROXY_URL=http://localhost:8081
DJANGO_API_PROXY_URL=http://localhost:8000
# Legacy alias (still honored if GO_API_PROXY_URL is unset):
# API_PROXY_URL=http://localhost:8081

# Or call a single backend directly (must allow CORS):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8081/api/v1

# Production:
# NEXT_PUBLIC_API_BASE_URL=https://api.rahil.gallery/api/v1
# GO_API_PROXY_URL=http://127.0.0.1:8080
# DJANGO_API_PROXY_URL=http://127.0.0.1:8000

# Optional: skip login in development (Bearer token sent on every API request)
# NEXT_PUBLIC_DEV_ACCESS_TOKEN=

# Optional: report client errors without a logged-in session
# NEXT_PUBLIC_OBSERVABILITY_INGEST_KEY=
