# Rehil Gallery — environment variables

# Backend API (Go server)
# Same-origin proxy (recommended for local dev):
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_PROXY_URL=http://localhost:8080

# Or call the backend directly (backend must allow CORS):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Production:
# NEXT_PUBLIC_API_BASE_URL=https://api.rehil.gallery/api/v1

# Optional: skip login in development (Bearer token sent on every API request)
# NEXT_PUBLIC_DEV_ACCESS_TOKEN=

# Optional: report client errors without a logged-in session
# NEXT_PUBLIC_OBSERVABILITY_INGEST_KEY=
